{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "Design tokens oficiales de La VeneConsteña (identidad de marca + WCAG AA).",
  "color": {
    "rojo": { "$value": "#E4492F", "$type": "color" },
    "rojo-cta": { "$value": "#C8371E", "$type": "color" },
    "rojo-hover": { "$value": "#AD2C16", "$type": "color" },
    "rojo-soft": { "$value": "#FDECE8", "$type": "color" },
    "verde": { "$value": "#8AB544", "$type": "color" },
    "verde-text": { "$value": "#426312", "$type": "color" },
    "verde-soft": { "$value": "#EEF6DF", "$type": "color" },
    "mostaza": { "$value": "#E8B93E", "$type": "color" },
    "mostaza-text": { "$value": "#7A5600", "$type": "color" },
    "mostaza-soft": { "$value": "#FDF4D7", "$type": "color" },
    "marron": { "$value": "#4A2C25", "$type": "color" },
    "marron-muted": { "$value": "#75564E", "$type": "color" },
    "crema": { "$value": "#FFF8EC", "$type": "color" },
    "crema-elevated": { "$value": "#FAF0DE", "$type": "color" },
    "blanco": { "$value": "#FFFFFF", "$type": "color" },
    "borde": { "$value": "#EBDCCB", "$type": "color" },
    "negro": { "$value": "#1A1A1A", "$type": "color" }
  },
  "font": {
    "display": { "$value": "\"Pacifico\", cursive", "$type": "fontFamily" },
    "heading": { "$value": "\"Baloo 2\", system-ui, sans-serif", "$type": "fontFamily" },
    "body": { "$value": "\"Nunito\", system-ui, sans-serif", "$type": "fontFamily" }
  },
  "radius": {
    "card": { "$value": "24px", "$type": "dimension" },
    "control": { "$value": "16px", "$type": "dimension" },
    "pill": { "$value": "9999px", "$type": "dimension" }
  },
  "semantic": {
    "color": {
      "primary": { "$value": "{color.rojo-cta}", "$type": "color" },
      "on-primary": { "$value": "{color.blanco}", "$type": "color" },
      "brand-accent": { "$value": "{color.rojo}", "$type": "color" },
      "secondary": { "$value": "{color.verde}", "$type": "color" },
      "on-secondary": { "$value": "{color.marron}", "$type": "color" },
      "accent": { "$value": "{color.mostaza}", "$type": "color" },
      "on-accent": { "$value": "{color.marron}", "$type": "color" },
      "background": { "$value": "{color.crema}", "$type": "color" },
      "foreground": { "$value": "{color.marron}", "$type": "color" },
      "card": { "$value": "{color.blanco}", "$type": "color" },
      "card-foreground": { "$value": "{color.marron}", "$type": "color" },
      "muted": { "$value": "{color.crema-elevated}", "$type": "color" },
      "muted-foreground": { "$value": "{color.marron-muted}", "$type": "color" },
      "border": { "$value": "{color.borde}", "$type": "color" },
      "ring": { "$value": "{color.rojo}", "$type": "color" }
    }
  }
}
